# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
BILLTRACK_LAN_IP=
BILLTRACK_TAILSCALE_IP=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TOTP_RESET_SECRET=
# Windows PDF support: set this only if WeasyPrint needs a custom DLL search folder.
# WEASYPRINT_DLL_DIRECTORIES=

# Optional outgoing reminder mail. Use an app password, never your normal password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Enable only after a successful SMTP test in Admin → Email reminders.
ACCOUNT_EMAIL_ENABLED=False
